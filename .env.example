# MySQL configuration
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=wp
MYSQL_PASSWORD=wppass
MYSQL_DATABASE=wordpress

# WordPress and phpMyAdmin ports
WP_PORT=8080
PMA_PORT=8081

# Mail
# WPBLADE_ENV=production に設定した環境のみ実際の宛先へ送信する。
# 未設定の場合は MailConstant::DEV_MAIL へリダイレクト（非本番共通）。
# MailConstant::DEV_MAIL が空文字の場合は WPBLADE_SMTP_HOST の SMTP サーバへ送信（ローカル MailHog 用）。
WPBLADE_ENV=
WPBLADE_SMTP_HOST=mailpit
WPBLADE_SMTP_PORT=1025
{
  "permissions": {
    "allow": [
      "Bash(vite --version)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(npm install *)",
      "Bash(npx vite *)",
      "Bash(docker-compose ps *)",
      "Bash(docker compose *)",
      "Bash(composer require *)",
      "Bash(docker-compose up *)",
      "Bash(docker-compose restart *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/rules-review-gate.sh\" --check"
          }
        ]
      }
    ]
  }
}
